{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch DEV Client",
            "type": "shell",
            "command": "cd client && npm run dev",
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
            "label": "Launch Server",
            "type": "shell",
            "command": "cd server && npm run server",
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
            "label": "Launch Browser",
            "type": "shell",
            "command": "start-Process 'msedge.exe' -ArgumentList '-inprivate https://192.168.1.141:3000'",
            "problemMatcher": []
        },
        {
            "label": "Run DEV Client & Server",
            "dependsOn": [
                "Launch DEV Client",
                "Launch Server",
                "Launch Browser"
            ],
            "dependsOrder": "parallel"
        }
    ],
}